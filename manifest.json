{
  "name": "realdebrid-unrestrictor",
  "title": "Real-Debrid Unrestrictor",
  "author": "Custom",
  "version": "1.0.1",
  "description": "Låser automatisk hoster-links op via Real-Debrid API",
  "icon": "https://real-debrid.com/favicon.ico",
  "homepage": "https://real-debrid.com",
  "entry": "index.js",
  "settings": [
    {
      "name": "api_token",
      "title": "Real-Debrid API Token",
      "type": "string",
      "default": "",
      "description": "Indsæt din API-nøgle fra real-debrid.com/apitoken"
    }
  ],
  "scripts": [
    {
      "event": "onResolve",
      "match": {
        "urls": [
          "*://1fichier.com/*",
          "*://*.1fichier.com/*",
          "*://rapidgator.net/*",
          "*://*.rapidgator.net/*",
          "*://ddownload.com/*",
          "*://*.ddownload.com/*",
          "*://mega.nz/*",
          "*://*.mega.nz/*"
        ]
      }
    }
  ]
}
